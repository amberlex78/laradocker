# System Nginx reverse proxy for the production Docker stack.
#
# Before enabling this file:
#   1. Replace esp32.xyz with the production hostname if necessary.
#   2. Install the certificate and key at /etc/nginx/ssl/cloudflare/, or update the paths below.
#   3. Make sure the Docker production stack publishes 127.0.0.1:8080.
#
# Example installation:
#   sudo cp prod.conf.example /etc/nginx/sites-available/esp32.xyz
#   sudo ln -s /etc/nginx/sites-available/esp32.xyz /etc/nginx/sites-enabled/esp32.xyz
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name esp32.xyz www.esp32.xyz;

    return 301 https://esp32.xyz$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name _;

    ssl_certificate /etc/nginx/ssl/cloudflare/esp32.xyz.origin.crt;
    ssl_certificate_key /etc/nginx/ssl/cloudflare/esp32.xyz.origin.key;

    return 301 https://esp32.xyz$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name esp32.xyz www.esp32.xyz;

    ssl_certificate /etc/nginx/ssl/cloudflare/esp32.xyz.origin.crt;
    ssl_certificate_key /etc/nginx/ssl/cloudflare/esp32.xyz.origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
        proxy_pass http://127.0.0.1:8080;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|woff|woff2|ttf)$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires 7d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location = /index.php {
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
