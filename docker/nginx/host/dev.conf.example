# Optional system Nginx configuration for local development.
#
# The development Compose stack publishes the container Nginx on
# 127.0.0.1:8000. This file is only a reverse proxy; it must not use the
# project checkout as its document root.
#
# Example installation:
#   sudo cp dev.conf.example /etc/nginx/sites-available/laravel-dev
#   sudo ln -s /etc/nginx/sites-available/laravel-dev /etc/nginx/sites-enabled/laravel-dev
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;

    server_name localhost;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
