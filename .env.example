COMPOSE_PROJECT_NAME=laradocker
IMAGE_TAG=local
APP_NAME=LaraDocker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Kyiv

# Laravel довіряє лише безпосередньо підключеному Docker Nginx.
# Для кількох proxy hops вкажіть явні IP-адреси або CIDR.
TRUSTED_PROXIES=REMOTE_ADDR

# See config/debugbar.php
DEBUGBAR_COLLECTORS_ROUTE=true


### Для другого одночасно запущеного проєкту змініть host-порти

# Host-порт застосунку.
# У другому задайте, наприклад, 8001.
DEV_HTTP_PORT=8000

# Host-порт Vite та порт Vite, який використовує браузер для HMR.
# У другому задайте, наприклад, 5174 для обох портів.
VITE_FORWARD_PORT=5173
VITE_HMR_PORT=5173

# Host-порт MariaDB для локальних клієнтів. 
# У другому задайте, наприклад, 3307.
DB_FORWARD_PORT=3306

# Host-порт Adminer. одночасно запущеному проєкті
# У другому задайте, наприклад, 8091.
ADMINER_FORWARD_PORT=8090

# Host-порти Mailpit для SMTP та web-інтерфейсу.
# У другому задайте, наприклад, 1026 і 8026.
MAILPIT_SMTP_FORWARD_PORT=1025
MAILPIT_FORWARD_PORT=8025


# Внутрішній порт Vite у контейнері (не змінюється для другого проєкту).
VITE_PORT=5173
VITE_HMR_HOST=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SEEDER_DEFAULT_PASSWORD=password

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# Внутрішня адреса MariaDB у Compose. Ці значення не є host-портами.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
