# Graphify ignore rules for this Laravel + Docker project.

# Version control and assistant state
.git/
.gitignore
.agents/
.codex/
.claude/
.cursor/
.idea/
.nova/
.pi/
.vscode/
.zed/

# Dependencies and package caches
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.cache/

# Environment files, credentials, and local configuration
.env
.env.*
!.env.example
auth.json
.phpactor.json

# Generated frontend and Laravel runtime files
public/build/
public/hot
public/storage/
bootstrap/cache/*.php
storage/*.key
storage/app/public/
storage/framework/cache/
storage/framework/sessions/
storage/framework/testing/
storage/framework/views/
storage/logs/
storage/pail/
.phpunit.result.cache
.phpunit.cache/
coverage/

# Graphify's own generated output
graphify-out/
**/graphify-out/

# Dependency lockfiles are not needed for architecture analysis
composer.lock
package-lock.json

# Editor and operating-system noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig

# Logs and generated archives
*.log
*.zip
*.tar
*.tar.gz
*.tgz

# Binary/media files without source context
*.bin
*.elf
*.hex
*.map
*.o
*.a
*.so
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
